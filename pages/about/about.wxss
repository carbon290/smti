page {
  background: linear-gradient(180deg, #f4fbff 0%, #eef5ff 100%);
}

.page-wrap {
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* ---------- 顶部标题区 ---------- */
.hero {
  background: linear-gradient(160deg, #ffffff 0%, #f1f9ff 100%);
  border: 1rpx solid rgba(211, 222, 238, 0.9);
  border-radius: 30rpx;
  padding: 30rpx 26rpx 28rpx;
  box-shadow: 0 20rpx 36rpx rgba(112, 144, 195, 0.1);
}

.hero-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #eaf7ff 0%, #e6f9f1 100%);
  color: #1f8fd8;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #1d2b3a;
  line-height: 1.35;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #78899c;
}

/* ---------- 通用区块 ---------- */
.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #233447;
}

.section-sub {
  font-size: 21rpx;
  color: #9aa9ba;
}

/* ---------- 维度卡片 ---------- */
.dim-card {
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(222, 230, 240, 0.9);
  border-radius: 24rpx;
  padding: 22rpx 22rpx 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 14rpx 28rpx rgba(140, 170, 210, 0.08);
}

.dim-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.dim-code {
  flex: none;
  width: 116rpx;
  height: 66rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #eef7ff 0%, #e8fbf3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dim-letter {
  font-size: 30rpx;
  font-weight: 800;
  color: #1d7fd4;
  line-height: 1;
}

.dim-letter-b {
  color: #16a882;
}

.dim-slash {
  margin: 0 6rpx;
  font-size: 22rpx;
  color: #b6c6d8;
  line-height: 1;
}

.dim-title {
  flex: 1;
  margin-left: 18rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #2a3850;
}

.dim-row {
  display: flex;
  align-items: flex-start;
}

.dim-row + .dim-row {
  margin-top: 16rpx;
}

.dim-bullet {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 13rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #69b7ff;
}

.dim-bullet-alt {
  background: #7ad7b8;
}

.dim-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.7;
  color: #5b6c80;
  white-space: normal;
  word-break: break-word;
}

.dim-strong {
  font-weight: 800;
  color: #2a3850;
}

/* ---------- 流程步骤 ---------- */
.step {
  display: flex;
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(222, 230, 240, 0.9);
  border-radius: 22rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

.step-num {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #69b7ff 0%, #7ad7b8 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(93, 176, 244, 0.24);
}

.step-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.step-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #233447;
}

.step-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7b8b9e;
}

/* ---------- 小提示 ---------- */
.note {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.note-dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  margin-top: 15rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #b9cbe0;
}

.note-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.75;
  color: #6c7d91;
  white-space: normal;
  word-break: break-word;
}

/* ---------- 底部操作 ---------- */
.footer {
  margin-top: 36rpx;
}

.start-btn {
  width: 100%;
}

.link {
  display: block;
  text-align: center;
  color: #4e6d8a;
  margin-top: 22rpx;
  font-size: 26rpx;
}
