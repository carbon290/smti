page {
  background: linear-gradient(180deg, #f4fbff 0%, #eef5ff 100%);
}

.page-wrap {
  padding: 32rpx 24rpx 44rpx;
  box-sizing: border-box;
}

/* ---------- 顶部主视觉 ---------- */
.hero-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, #ffffff 0%, #f2f9ff 100%);
  border: 1rpx solid rgba(211, 222, 238, 0.9);
  border-radius: 30rpx;
  padding: 28rpx 24rpx 26rpx;
  box-shadow: 0 20rpx 36rpx rgba(112, 144, 195, 0.1);
  text-align: center;
}

/* 右上角装饰光斑 */
.hero-card::after {
  content: '';
  position: absolute;
  top: -70rpx;
  right: -70rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(103, 184, 255, 0.22) 0%, rgba(103, 184, 255, 0) 70%);
}

.hero-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #eaf7ff 0%, #e6f9f1 100%);
  color: #1f8fd8;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 46rpx;
  font-weight: 800;
  color: #1d2b3a;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: #697b8f;
}

.avatar-ring {
  width: 180rpx;
  height: 180rpx;
  margin: 30rpx auto 0;
  border-radius: 50%;
  background: linear-gradient(180deg, #f1f5fa 0%, #e9f3ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 8rpx rgba(255, 255, 255, 0.8), 0 12rpx 24rpx rgba(120, 165, 220, 0.16);
}

.avatar-inner {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7ad7b8 0%, #64b7ff 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* 主视觉下方的数据条 */
.hero-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed rgba(190, 208, 232, 0.8);
}

.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #1d7fd4;
  line-height: 1.2;
}

.meta-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8496a8;
}

.meta-divider {
  width: 1rpx;
  height: 46rpx;
  background: #e3ebf5;
}

/* ---------- 四维维度卡片 ---------- */
.info-panel {
  margin-top: 26rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 26rpx;
  padding: 22rpx 22rpx 8rpx;
  border: 1rpx solid rgba(222, 230, 240, 0.9);
  box-shadow: 0 14rpx 28rpx rgba(140, 170, 210, 0.08);
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.info-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #233447;
}

.info-tip {
  font-size: 22rpx;
  color: #9aa9ba;
}

.dim-list {
  margin-top: 16rpx;
}

.dim-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef3fa;
}

.dim-item:last-child {
  border-bottom: none;
}

.dim-code {
  flex: none;
  width: 104rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #eef7ff 0%, #e8fbf3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dim-a,
.dim-b {
  font-size: 30rpx;
  font-weight: 800;
  color: #1d7fd4;
}

.dim-slash {
  margin: 0 6rpx;
  font-size: 24rpx;
  color: #b6c6d8;
}

.dim-text {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.dim-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #2a3850;
}

.dim-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8b9aab;
  line-height: 1.5;
}

/* ---------- 底部操作区 ---------- */
.footer {
  margin-top: 32rpx;
}

.start-btn {
  width: 100%;
}

.link {
  display: block;
  text-align: center;
  color: #4e6d8a;
  margin-top: 20rpx;
  font-size: 26rpx;
}
