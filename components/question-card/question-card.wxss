.qcard {
  background: rgba(255, 255, 255, 0.9);
  padding: 32rpx 26rpx 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 32rpx rgba(102, 140, 192, 0.12);
  border: 1rpx solid rgba(206, 222, 246, 0.9);
  margin-bottom: 28rpx;
}

.q-text {
  display: block;
  margin-bottom: 24rpx;
  font-size: var(--question-font-size, 30rpx);
  line-height: 1.7;
  color: #212a39;
  font-weight: 600;
  white-space: normal;
  word-break: break-word;
  word-wrap: break-word;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.opt {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  padding: 22rpx 24rpx;
  text-align: left;
  background: linear-gradient(180deg, #f7faff 0%, #eef7ff 100%);
  border: 2rpx solid #dfeaf8;
  border-radius: 20rpx;
  box-sizing: border-box;
  color: #2a3850;
  transition: all 0.2s ease;
}

.opt::after {
  border: 0;
  border-radius: 20rpx;
}

.option-text {
  display: block;
  width: 100%;
  text-align: left;
  line-height: 1.6;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
  font-size: 28rpx;
}

.opt.selected {
  background: linear-gradient(180deg, #eaf7ff 0%, #dff3ff 100%);
  border-color: #72b8ff;
  color: #0d6dd8;
  box-shadow: inset 0 0 0 1px rgba(114, 184, 255, 0.18);
}
